{
  "expo": {
    "name": "HERE",
    "slug": "left-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./app-icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "left",
    "splash": {
      "image": "./assets/brand/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF7F5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.left.mobile",
      "appleTeamId": "3Y42VMC42F",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to detect when you are in a social venue. We never share it.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We use your location in the background to detect when you are in a social venue. We never share it.",
        "UIBackgroundModes": [
          "location",
          "location"
        ]
      },
      "buildNumber": "9",
      "runtimeVersion": "1.0.1"
    },
    "android": {
      "package": "com.left.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/left-app-icon-foreground.png",
        "backgroundColor": "#C6E385"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "@rnmapbox/maps",
      "expo-notifications",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow HERE to attach a photo to a community venue."
        }
      ],
      "expo-font",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "fi",
            "sv"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7822054a-27b1-4e97-95ae-425580088f47"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/7822054a-27b1-4e97-95ae-425580088f47"
    }
  }
}
