# Set in Supabase Edge Function secrets, never Expo client env.
# This sentinel disables paid lookups until replaced with a real token.
APIFY_TOKEN=REPLACE_WITH_APIFY_TOKEN
APIFY_POPULAR_TIMES_ACTOR=compass/crawler-google-places
POPULAR_TIMES_PROVIDER=google_scrape
# Apple removal requires a fresh native authorization code and server-side client secret.
APPLE_CLIENT_ID=com.left.mobile
APPLE_CLIENT_SECRET=
# Public TestFlight invitation or public App Store URL for shared gathering pages.
LEFT_DOWNLOAD_URL=
