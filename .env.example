EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Server-only configuration template: supabase/functions/.env.example

# User-supplied HERE pages are pre-launch drafts, verified 2026-10-20.
# Leave metadata blank until final publication and matching registry versions are approved.
EXPO_PUBLIC_LEGAL_TERMS_URL=https://here-web-azure.vercel.app/terms
EXPO_PUBLIC_LEGAL_PRIVACY_URL=https://here-web-azure.vercel.app/privacy
EXPO_PUBLIC_LEGAL_COMMUNITY_URL=https://here-web-azure.vercel.app/community-guidelines
EXPO_PUBLIC_LEGAL_TERMS_VERSION=
EXPO_PUBLIC_LEGAL_PRIVACY_VERSION=
EXPO_PUBLIC_LEGAL_COMMUNITY_VERSION=
EXPO_PUBLIC_LEGAL_TERMS_EFFECTIVE_DATE=
EXPO_PUBLIC_LEGAL_PRIVACY_EFFECTIVE_DATE=
EXPO_PUBLIC_LEGAL_COMMUNITY_EFFECTIVE_DATE=

# HTTPS root origin hosting /g/<code>; leave blank until sharing is deployed.
EXPO_PUBLIC_GATHERING_SHARE_ORIGIN=
